# Playback token ki mohar. Lambi random string chahiye. Banane ka tareeqa:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
PLAYBACK_SECRET=b907fd24d3f0639dd11d899655ff112821376a924b4cc9cc7de6e89a867d136f
# Playback token kitne ghante chalta hai (4 ghante ki lecture ke liye 12 kaafi hai)
PLAYBACK_TTL_HOURS=12

# Videos kahan save hongi (server folder ke andar "storage" default hai)
STORAGE_DIR=storage

# Ek video ki max size (GB)
MAX_UPLOAD_GB=10

# Agar ffmpeg PATH mein nahi hai to poora path likhein (Windows example: C:\ffmpeg\bin\ffmpeg.exe)
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
